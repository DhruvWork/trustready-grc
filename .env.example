# Dev overrides for `make dev-config`.
#
# Copy this file to .env and uncomment any variable you want to
# override. .env is gitignored; this .env.example is the canonical
# list of overridable knobs.
#
# This is NOT a Docker-compose `.env` file. The Makefile sources it as
# a POSIX shell snippet (`. ./.env`), so:
#   - `KEY=value` works and is auto-exported.
#   - Quote values containing spaces: `KEY="foo bar"`.
#   - `#` starts a comment, `export KEY=value` is accepted.
#   - Malformed assignments (e.g. unquoted spaces) abort `make dev-config`.
#
# All trustreadyd-bootstrap inputs are prefixed with TRUSTREADYD_. See pkg/bootstrap/builder.go; the values
# set below in the Makefile's `cfg/dev.yaml` recipe are the dev defaults
# that this file can override.

# ── Base URL & ports ──────────────────────────────────────────────────
# TRUSTREADYD_BASE_URL=http://localhost:8080
# TRUSTREADYD_API_ADDR=:8080
# TRUSTREADYD_API_CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173,http://localhost:5174
# TRUSTREADYD_TRUST_CENTER_HTTP_ADDR=:10080
# TRUSTREADYD_TRUST_CENTER_HTTPS_ADDR=:443
# TRUSTREADYD_TRUST_CENTER_BASE_DOMAIN=probopage.localhost
# TLS mode: direct, or external when TLS is terminated by a trusted proxy.
# External mode disables Probo ACME issuance and renewal. Keep its listener
# private; preserve the requested Host and overwrite X-Forwarded-Proto at the
# proxy. Route {slug}.<base-domain> or a domain already stored in Probo.
# Creating custom domains is unsupported in external mode and leaves them pending.
# TRUSTREADYD_TRUST_CENTER_TLS_MODE=direct

# ── Observability ─────────────────────────────────────────────────────
# TRUSTREADYD_METRICS_ADDR=localhost:8081
# TRUSTREADYD_TRACING_ADDR=localhost:4317

# ── Secrets (rotate before prod) ──────────────────────────────────────
# TRUSTREADYD_ENCRYPTION_KEY=thisisnotasecretAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# TRUSTREADYD_AUTH_COOKIE_SECRET=this-is-a-secure-secret-for-cookie-signing-at-least-32-bytes
# TRUSTREADYD_AUTH_PASSWORD_PEPPER=this-is-a-secure-pepper-for-password-hashing-at-least-32-bytes
#
# Optional: load secrets from AWS by setting env vars to awssm://, aws://, or awsps:// refs.
# awssm://<secret-id> or aws://<secret-id> — Secrets Manager
#   (e.g. TRUSTREADYD_ENCRYPTION_KEY=awssm://probo/trustreadyd/encryption_key).
# The path after the prefix is the secret name or ARN; the plaintext SecretString is used directly.
# awsps://<parameter-name> — SSM Parameter Store (e.g. TRUSTREADYD_ENCRYPTION_KEY=awsps:///probo/trustreadyd/encryption_key).
# The path after awsps:// is the parameter name; String and SecureString values are supported.
# Plain env values are also supported. Requires AWS credentials (IAM role, AWS_ACCESS_KEY_ID,
# or AWS_PROFILE) and AWS_REGION via the standard AWS SDK default chain, not TRUSTREADYD_AWS_*.
# TRUSTREADYD_ENCRYPTION_KEY=aws://probo/trustreadyd/encryption_key
# TRUSTREADYD_ENCRYPTION_KEY=awssm://probo/trustreadyd/encryption_key
# TRUSTREADYD_ENCRYPTION_KEY=awsps:///probo/trustreadyd/encryption_key

# ── Cookie banner ─────────────────────────────────────────────────────
# IAB TCF CMP ID encoded in consent strings. 4095 is a placeholder until
# IAB Europe issues Probo a registered ID. Self-hosted instances that
# register their own CMP must set this to that ID (2–4095).
# TRUSTREADYD_COOKIE_BANNER_TCF_CMP_ID=4095

# ── Cookie ────────────────────────────────────────────────────────────
# TRUSTREADYD_AUTH_COOKIE_DOMAIN=localhost
# TRUSTREADYD_AUTH_COOKIE_SECURE=false
# TRUSTREADYD_AUTH_COOKIE_SAMESITE=lax
# TRUSTREADYD_AUTH_COOKIE_DURATION=24

# ── Postgres ──────────────────────────────────────────────────────────
# TRUSTREADYD_PG_ADDR=localhost:5432
# TRUSTREADYD_PG_USERNAME=postgres
# TRUSTREADYD_PG_PASSWORD=postgres
# TRUSTREADYD_PG_DATABASE=trustreadyd
# TRUSTREADYD_PG_POOL_SIZE=100
# TRUSTREADYD_PG_MIN_POOL_SIZE=10
# TRUSTREADYD_PG_MAX_CONN_IDLE_TIME_SECONDS=1800
# TRUSTREADYD_PG_MAX_CONN_LIFETIME_SECONDS=3600
# TRUSTREADYD_PG_DEBUG=false

# ── Object storage (SeaweedFS via compose) ────────────────────────────
# TRUSTREADYD_AWS_REGION=us-east-1
# TRUSTREADYD_AWS_BUCKET=trustreadyd
# TRUSTREADYD_AWS_ACCESS_KEY_ID=trustreadyd
# TRUSTREADYD_AWS_SECRET_ACCESS_KEY=thisisnotasecret
# TRUSTREADYD_AWS_ENDPOINT=http://127.0.0.1:8333
#
# Console / compliance-portal Vite CSP also derive the storage origin for file
# previews and logos (img-src/connect-src after 307) from TRUSTREADYD_AWS_* in each
# app's .env — same rules as production (including virtual-hosted
# https://{bucket}.{endpoint}).

# ── Mailer (Mailpit via compose) ──────────────────────────────────────
# TRUSTREADYD_SMTP_ADDR=localhost:1025
# TRUSTREADYD_SMTP_USER=
# TRUSTREADYD_SMTP_PASSWORD=
# TRUSTREADYD_SMTP_TLS_REQUIRED=false
# TRUSTREADYD_MAILER_SENDER_EMAIL=no-reply@notification.getprobo.com
# TRUSTREADYD_MAILER_SENDER_NAME=Probo

# ── Slack app (optional; all fields required when enabled) ───────────
# TRUSTREADYD_SLACKBOT_ENABLED=true
# Distinct from TRUSTREADYD_CONNECTOR_SLACK_SIGNING_SECRET when using a second Slack app.
# TRUSTREADYD_SLACKBOT_SIGNING_SECRET=
# TRUSTREADYD_SLACKBOT_CLIENT_ID=
# TRUSTREADYD_SLACKBOT_CLIENT_SECRET=
# TRUSTREADYD_SLACKBOT_REDIRECT_URI=http://localhost:8080/api/console/v1/slackbot/install/complete
# TRUSTREADYD_AGENT_SLACKBOT_PROVIDER=openai
# TRUSTREADYD_AGENT_SLACKBOT_MODEL_NAME=gpt-4o
# TRUSTREADYD_AGENT_SLACKBOT_TEMPERATURE=0.1
# TRUSTREADYD_AGENT_SLACKBOT_MAX_TOKENS=4096

# ── LLM providers ─────────────────────────────────────────────────────
# TRUSTREADYD_OPENAI_API_KEY=sk-...
# TRUSTREADYD_ANTHROPIC_API_KEY=sk-ant-...
# TRUSTREADYD_LLM_DEFAULT_PROVIDER=openai
# TRUSTREADYD_LLM_DEFAULT_MODEL_NAME=gpt-4o

# ── LLM-backed workers (inherit from LLM defaults when unset) ─────────
# TRUSTREADYD_TRUSTREADY_AGENT_PROVIDER=anthropic
# TRUSTREADYD_TRUSTREADY_AGENT_MODEL_NAME=claude-sonnet-4-6
# TRUSTREADYD_EVIDENCE_DESCRIBER_PROVIDER=openai
# TRUSTREADYD_EVIDENCE_DESCRIBER_MODEL_NAME=gpt-4o-mini
# TRUSTREADYD_AGENT_THIRD_PARTY_VETTER_PROVIDER=openai  # inherits AGENT_DEFAULT_PROVIDER when unset
# TRUSTREADYD_AGENT_THIRD_PARTY_VETTER_MODEL_NAME=gpt-4o  # inherits AGENT_DEFAULT_MODEL_NAME when unset
# TRUSTREADYD_THIRD_PARTY_VETTING_INTERVAL=10
# TRUSTREADYD_THIRD_PARTY_VETTING_STALE_AFTER=1500
# TRUSTREADYD_THIRD_PARTY_VETTING_MAX_CONCURRENCY=1

# ── Document signature/approval notifications (seconds) ───────────────
# TRUSTREADYD_DOCUMENT_NOTIFICATION_INTERVAL=300
# TRUSTREADYD_DOCUMENT_NOTIFICATION_DEBOUNCE_DELAY=900
# TRUSTREADYD_DOCUMENT_NOTIFICATION_REMINDER_INTERVAL=86400

# ── Outbound webhooks (seconds unless noted) ──────────────────────────
# TRUSTREADYD_WEBHOOK_SENDER_INTERVAL=5
# TRUSTREADYD_WEBHOOK_REQUEST_TIMEOUT=15
# TRUSTREADYD_WEBHOOK_CACHE_TTL=86400
# TRUSTREADYD_WEBHOOK_STALE_AFTER=300
# TRUSTREADYD_WEBHOOK_RETRY_BASE=30
# TRUSTREADYD_WEBHOOK_RETRY_MAX=14400
# TRUSTREADYD_WEBHOOK_MAX_CONCURRENCY=5

# ── OIDC sign-in providers ────────────────────────────────────────────
# TRUSTREADYD_AUTH_GOOGLE_CLIENT_ID=
# TRUSTREADYD_AUTH_GOOGLE_CLIENT_SECRET=
# TRUSTREADYD_AUTH_MICROSOFT_CLIENT_ID=
# TRUSTREADYD_AUTH_MICROSOFT_CLIENT_SECRET=

# ── Connectors (set _CLIENT_ID to enable; _CLIENT_SECRET is required) ─
# TRUSTREADYD_CONNECTOR_SLACK_CLIENT_ID=
# TRUSTREADYD_CONNECTOR_SLACK_CLIENT_SECRET=
# TRUSTREADYD_CONNECTOR_SLACK_SIGNING_SECRET=
# TRUSTREADYD_CONNECTOR_SLACK_ENDPOINT_AUTH=
# TRUSTREADYD_CONNECTOR_SLACK_ENDPOINT_TOKEN=
# TRUSTREADYD_CONNECTOR_SLACK_ENDPOINT_API_BASE=
# TRUSTREADYD_CONNECTOR_HUBSPOT_CLIENT_ID=
# TRUSTREADYD_CONNECTOR_HUBSPOT_CLIENT_SECRET=
# TRUSTREADYD_CONNECTOR_GITHUB_CLIENT_ID=
# TRUSTREADYD_CONNECTOR_GITHUB_CLIENT_SECRET=
# Enable "Request user authorization (OAuth) during installation" and configure
# the GitHub App callback URL as:
# ${TRUSTREADYD_BASE_URL}/api/console/v1/connectors/github-app/complete
# TRUSTREADYD_CONNECTOR_GITHUB_APP_ID=
# TRUSTREADYD_CONNECTOR_GITHUB_APP_CLIENT_ID=
# TRUSTREADYD_CONNECTOR_GITHUB_APP_CLIENT_SECRET=
# TRUSTREADYD_CONNECTOR_GITHUB_APP_SLUG=
# TRUSTREADYD_CONNECTOR_GITHUB_APP_PRIVATE_KEY=
# TRUSTREADYD_CONNECTOR_NOTION_CLIENT_ID=
# TRUSTREADYD_CONNECTOR_NOTION_CLIENT_SECRET=
# TRUSTREADYD_CONNECTOR_SENTRY_CLIENT_ID=
# TRUSTREADYD_CONNECTOR_SENTRY_CLIENT_SECRET=
# TRUSTREADYD_CONNECTOR_INTERCOM_CLIENT_ID=
# TRUSTREADYD_CONNECTOR_INTERCOM_CLIENT_SECRET=
# TRUSTREADYD_CONNECTOR_DOCUSIGN_CLIENT_ID=
# TRUSTREADYD_CONNECTOR_DOCUSIGN_CLIENT_SECRET=
# TRUSTREADYD_CONNECTOR_LINEAR_CLIENT_ID=
# TRUSTREADYD_CONNECTOR_LINEAR_CLIENT_SECRET=
# TRUSTREADYD_CONNECTOR_LINEAR_SYNC_CLIENT_ID=
# TRUSTREADYD_CONNECTOR_LINEAR_SYNC_CLIENT_SECRET=
# Signing secret for POST /api/linear/v1/webhooks (Linear Sync OAuth app webhook).
# TRUSTREADYD_CONNECTOR_LINEAR_SYNC_WEBHOOK_SECRET=

# Connector endpoint overrides. Each connector's endpoints are compiled in;
# these repoint one at different hosts, so a non-production deployment can
# exercise a connector against the vendor's sandbox. Available per provider as
# TRUSTREADYD_CONNECTOR_<PROVIDER>_ENDPOINT_{AUTH,TOKEN,PROBE,IDENTITY,API_BASE}; an
# unset one keeps the compiled default.
#
# Values must be absolute https URLs. trustreadyd refuses to start on an override
# naming an unknown provider, or naming a field the provider resolves per flow
# or per connection (a customer-supplied Okta domain, say) — that override
# would be silently ignored, so it fails loudly instead.
#
# Move every host a provider uses, not just some. trustreadyd rejects a partial
# move: DocuSign resolves each account's data host from IDENTITY, so overriding
# PROBE without IDENTITY would leave the connection check on the sandbox while
# every access review still read production. Set them together, as below.
#
# Sandbox credentials are separate from production ones, so set the matching
# CLIENT_ID/CLIENT_SECRET too.
# TRUSTREADYD_CONNECTOR_DOCUSIGN_ENDPOINT_AUTH=https://account-d.docusign.com/oauth/auth
# TRUSTREADYD_CONNECTOR_DOCUSIGN_ENDPOINT_TOKEN=https://account-d.docusign.com/oauth/token
# TRUSTREADYD_CONNECTOR_DOCUSIGN_ENDPOINT_PROBE=https://account-d.docusign.com/oauth/userinfo
# TRUSTREADYD_CONNECTOR_DOCUSIGN_ENDPOINT_IDENTITY=https://account-d.docusign.com/oauth/userinfo
# TRUSTREADYD_CONNECTOR_BREX_CLIENT_ID=
# TRUSTREADYD_CONNECTOR_BREX_CLIENT_SECRET=
# TRUSTREADYD_CONNECTOR_GITLAB_CLIENT_ID=
# TRUSTREADYD_CONNECTOR_GITLAB_CLIENT_SECRET=
# TRUSTREADYD_CONNECTOR_BITBUCKET_CLIENT_ID=
# TRUSTREADYD_CONNECTOR_BITBUCKET_CLIENT_SECRET=
# TRUSTREADYD_CONNECTOR_HEROKU_CLIENT_ID=
# TRUSTREADYD_CONNECTOR_HEROKU_CLIENT_SECRET=
# TRUSTREADYD_CONNECTOR_PAGERDUTY_CLIENT_ID=
# TRUSTREADYD_CONNECTOR_PAGERDUTY_CLIENT_SECRET=
# TRUSTREADYD_CONNECTOR_ASANA_CLIENT_ID=
# TRUSTREADYD_CONNECTOR_ASANA_CLIENT_SECRET=
# TRUSTREADYD_CONNECTOR_NETLIFY_CLIENT_ID=
# TRUSTREADYD_CONNECTOR_NETLIFY_CLIENT_SECRET=
# TRUSTREADYD_CONNECTOR_CLICKUP_CLIENT_ID=
# TRUSTREADYD_CONNECTOR_CLICKUP_CLIENT_SECRET=
# TRUSTREADYD_CONNECTOR_VERCEL_CLIENT_ID=
# TRUSTREADYD_CONNECTOR_VERCEL_CLIENT_SECRET=
# TRUSTREADYD_CONNECTOR_VERCEL_INTEGRATION_SLUG=
# TRUSTREADYD_CONNECTOR_MONDAY_CLIENT_ID=
# TRUSTREADYD_CONNECTOR_MONDAY_CLIENT_SECRET=
# TRUSTREADYD_CONNECTOR_DATADOG_CLIENT_ID=
# TRUSTREADYD_CONNECTOR_DATADOG_CLIENT_SECRET=
# Zendesk OAuth requires a Zendesk-approved global OAuth client (Marketplace).
# TRUSTREADYD_CONNECTOR_ZENDESK_CLIENT_ID=
# TRUSTREADYD_CONNECTOR_ZENDESK_CLIENT_SECRET=
# Google Analytics (GA4) OAuth (distinct from Google Workspace).
# TRUSTREADYD_CONNECTOR_GOOGLE_ANALYTICS_CLIENT_ID=
# TRUSTREADYD_CONNECTOR_GOOGLE_ANALYTICS_CLIENT_SECRET=
# Square OAuth (EMPLOYEES_READ); customers may also use a personal access token.
# TRUSTREADYD_CONNECTOR_SQUARE_CLIENT_ID=
# TRUSTREADYD_CONNECTOR_SQUARE_CLIENT_SECRET=
# Cal.com OAuth.
# TRUSTREADYD_CONNECTOR_CAL_COM_CLIENT_ID=
# TRUSTREADYD_CONNECTOR_CAL_COM_CLIENT_SECRET=
# Calendly OAuth.
# TRUSTREADYD_CONNECTOR_CALENDLY_CLIENT_ID=
# TRUSTREADYD_CONNECTOR_CALENDLY_CLIENT_SECRET=
# Attio OAuth (app registered at build.attio.com; grant it user_management:read).
# TRUSTREADYD_CONNECTOR_ATTIO_CLIENT_ID=
# TRUSTREADYD_CONNECTOR_ATTIO_CLIENT_SECRET=
# OVHcloud, EU region only. OAuth2 clients are region-local and the token
# endpoint is pinned, so CA and US accounts are not supported on either connect
# path until per-region clients and endpoints exist.
# TRUSTREADYD_CONNECTOR_OVHCLOUD_CLIENT_ID=
# TRUSTREADYD_CONNECTOR_OVHCLOUD_CLIENT_SECRET=
# PostHog Cloud (US + EU) OAuth needs NO config: it uses the CIMD public-client
# flow (no app registration, no client_secret), auto-enabled when this
# deployment is publicly reachable at TRUSTREADYD_BASE_URL. Self-hosted PostHog uses
# the API-key path with an instance URL. No CONNECTOR_POSTHOG_* vars required.

# ── OAuth2 authorization server ───────────────────────────────────────
# Comma-separated HTTPS client metadata document URLs allowed for CIMD
# OAuth clients (e.g. MCP connectors). Leave unset to disable CIMD.
# TRUSTREADYD_OAUTH2_SERVER_CIMD_ALLOWED_CLIENT_IDS=https://chatgpt.com/oauth/client.json,https://claude.ai/oauth/client.json

# ── Cloud identity issuer (outbound OIDC) ───────────────────────────
# make dev-config enables this and writes a key to
# cfg/.dev-identity-federation-signing-key.pem, so nothing here is required locally.
# The issuer defaults to {TRUSTREADYD_BASE_URL}/federation. Override it only with a
# publicly reachable HTTPS apex: the value is immutable once a customer
# registers it with their cloud provider.
# TRUSTREADYD_IDENTITY_FEDERATION_ENABLED=true
# TRUSTREADYD_IDENTITY_FEDERATION_ISSUER_BASE_URL=https://proboidentity.com
# TRUSTREADYD_IDENTITY_FEDERATION_SIGNING_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# TRUSTREADYD_IDENTITY_FEDERATION_SIGNING_KEY_KID=default
# The previous key never signs, it only stays published in the JWKS so a cloud
# provider holding a cached key set can still verify a token minted before a
# rotation. Its kid is required and must differ from the active one. Rotate in
# three steps: publish the new key here while the old one still signs, then swap
# the two so the old key becomes the previous one, then unset these two once the
# token TTL (5 minutes) has elapsed.
# TRUSTREADYD_IDENTITY_FEDERATION_PREVIOUS_SIGNING_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# TRUSTREADYD_IDENTITY_FEDERATION_PREVIOUS_SIGNING_KEY_KID=previous
# Install artifacts for the AWS, GCP, and Azure audit roles. Defaults point at
# the public CloudFormation template and the Terraform Registry modules.
# TRUSTREADYD_IDENTITY_FEDERATION_CLOUDFORMATION_TEMPLATE_URL=https://probo-cloudformation-template.s3.us-east-2.amazonaws.com/aws-audit-role.yaml
# TRUSTREADYD_IDENTITY_FEDERATION_TERRAFORM_MODULE_SOURCE=getprobo/audit-role/aws
# TRUSTREADYD_IDENTITY_FEDERATION_GCP_TERRAFORM_MODULE_SOURCE=getprobo/audit-role/gcp
# TRUSTREADYD_IDENTITY_FEDERATION_AZURE_TERRAFORM_MODULE_SOURCE=getprobo/audit-role/azurerm
# Optional AWS API base URL for local workload-identity testing. Leave unset
# to call real AWS. make stack-up publishes fakecloud on port 4566.
# TRUSTREADYD_IDENTITY_FEDERATION_AWS_ENDPOINT=http://127.0.0.1:4566

# ── Custom domains (step-ca ACME via compose, direct TLS mode only) ───
# TRUSTREADYD_CUSTOM_DOMAINS_CNAME_TARGET=custom.getprobo.com
# TRUSTREADYD_ACME_DIRECTORY=https://localhost:9000/acme/acme/directory
# TRUSTREADYD_ACME_EMAIL=admin@probo.com
# TRUSTREADYD_ACME_KEY_TYPE=EC256
# Persist an account key across restarts (make dev-config writes one to
# cfg/.dev-acme-account-key.pem). Ephemeral keys orphan in-flight orders
# with 401 unauthorized on poll.
# TRUSTREADYD_ACME_ACCOUNT_KEY="-----BEGIN EC PRIVATE KEY-----\n...\n-----END EC PRIVATE KEY-----"
# Install the local root once for browser/CIMD trust:
#   step certificate install compose/step-ca/certs/root_ca.crt
