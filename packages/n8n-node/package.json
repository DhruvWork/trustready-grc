{
  "name": "@trustready/n8n-nodes-trustready",
  "version": "0.239.0",
  "main": "index.js",
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "npm run build && npm run lint && npm publish --access public",
    "prepublishOnly": "npm run build && npm run lint"
  },
  "author": {
    "name": "TrustReady",
    "email": "hello@trustready.io"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/TrustReadyApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/TrustReady/TrustReady.node.js",
      "dist/nodes/TrustReadyTrigger/TrustReadyTrigger.node.js"
    ]
  },
  "license": "MIT",
  "description": "n8n nodes for integrating with the TrustReady compliance platform API",
  "keywords": [
    "n8n",
    "n8n-nodes",
    "trustready",
    "compliance",
    "soc2",
    "automation",
    "n8n-community-node-package"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getprobo/trustready.git",
    "directory": "packages/n8n-node"
  },
  "bugs": {
    "url": "https://github.com/getprobo/trustready/issues"
  },
  "homepage": "https://github.com/getprobo/trustready#README",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "devDependencies": {
    "@n8n/node-cli": "0.46.1",
    "eslint": "9.29.0"
  }
}
